  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#dbeedd"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>PK user_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id">FK role_id</TD></TR><TR><TD ALIGN="LEFT" PORT="officer_id">FK officer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="username">username</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD></TR><TR><TD ALIGN="LEFT"><I>+ 2 more</I></TD></TR></TABLE>>];
  verdicts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#d6e2f6"><B>verdicts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="verdict_id"><B>PK verdict_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="case_id">FK case_id</TD></TR><TR><TD ALIGN="LEFT" PORT="fir_accused_id">FK fir_accused_id</TD></TR><TR><TD ALIGN="LEFT" PORT="verdict">verdict</TD></TR><TR><TD ALIGN="LEFT" PORT="verdict_on">verdict_on</TD></TR><TR><TD ALIGN="LEFT"><I>+ 3 more</I></TD></TR></TABLE>>];
  arrests:fir_accused_id -> fir_accused [arrowtail=crow, arrowhead=tee];
  arrests:arrested_by -> officers [arrowtail=crow, arrowhead=tee];
  bail_applications:fir_accused_id -> fir_accused [arrowtail=crow, arrowhead=tee];
