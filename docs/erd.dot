digraph erd {
  graph [rankdir=LR, splines=true, nodesep=0.28, ranksep=1.1, fontname="Helvetica", pad=0.3, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [color="#55636b", arrowsize=0.7, dir=both, penwidth=1.0];
  arrests [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>arrests</B></TD></TR><TR><TD ALIGN="LEFT" PORT="arrest_id"><B>PK arrest_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_accused_id">FK fir_accused_id</TD></TR><TR><TD ALIGN="LEFT" PORT="arrested_by">FK arrested_by</TD></TR><TR><TD ALIGN="LEFT" PORT="arrested_at">arrested_at</TD></TR><TR><TD ALIGN="LEFT" PORT="location">location</TD></TR><TR><TD ALIGN="LEFT"><I>+ 2 more</I></TD></TR></TABLE>>];
  bail_applications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#d6e2f6"><B>bail_applications</B></TD></TR><TR><TD ALIGN="LEFT" PORT="bail_id"><B>PK bail_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_accused_id">FK fir_accused_id</TD></TR><TR><TD ALIGN="LEFT" PORT="court_id">FK court_id</TD></TR><TR><TD ALIGN="LEFT" PORT="bail_type">bail_type</TD></TR><TR><TD ALIGN="LEFT" PORT="applied_on">applied_on</TD></TR><TR><TD ALIGN="LEFT"><I>+ 4 more</I></TD></TR></TABLE>>];
  case_diary [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>case_diary</B></TD></TR><TR><TD ALIGN="LEFT" PORT="diary_id"><B>PK diary_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="officer_id">FK officer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="entry_date">entry_date</TD></TR><TR><TD ALIGN="LEFT" PORT="entry_text">entry_text</TD></TR></TABLE>>];
  court_cases [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#d6e2f6"><B>court_cases</B></TD></TR><TR><TD ALIGN="LEFT" PORT="case_id"><B>PK case_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="court_id">FK court_id</TD></TR><TR><TD ALIGN="LEFT" PORT="case_number">case_number</TD></TR><TR><TD ALIGN="LEFT" PORT="filed_on">filed_on</TD></TR><TR><TD ALIGN="LEFT"><I>+ 1 more</I></TD></TR></TABLE>>];
  courts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#d6e2f6"><B>courts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="court_id"><B>PK court_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="district_id">FK district_id</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT" PORT="court_type">court_type</TD></TR><TR><TD ALIGN="LEFT"><I>+ 1 more</I></TD></TR></TABLE>>];
  crime_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#e3e8ec"><B>crime_categories</B></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><B>PK category_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD></TR></TABLE>>];
  districts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#e3e8ec"><B>districts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="district_id"><B>PK district_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT" PORT="province">province</TD></TR></TABLE>>];
  evidence [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#f6d6d6"><B>evidence</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id"><B>PK evidence_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="type_id">FK type_id</TD></TR><TR><TD ALIGN="LEFT" PORT="collected_by">FK collected_by</TD></TR><TR><TD ALIGN="LEFT" PORT="current_custodian_id">FK current_custodian_id</TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_no">evidence_no</TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD></TR><TR><TD ALIGN="LEFT"><I>+ 5 more</I></TD></TR></TABLE>>];
  evidence_custody_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#f6d6d6"><B>evidence_custody_log</B></TD></TR><TR><TD ALIGN="LEFT" PORT="log_id"><B>PK log_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id">FK evidence_id</TD></TR><TR><TD ALIGN="LEFT" PORT="from_officer_id">FK from_officer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="to_officer_id">FK to_officer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="transferred_at">transferred_at</TD></TR><TR><TD ALIGN="LEFT" PORT="purpose">purpose</TD></TR></TABLE>>];
  evidence_types [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#e3e8ec"><B>evidence_types</B></TD></TR><TR><TD ALIGN="LEFT" PORT="type_id"><B>PK type_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT" PORT="is_digital">is_digital</TD></TR></TABLE>>];
  fir_accused [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>fir_accused</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_accused_id"><B>PK fir_accused_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="person_id">FK person_id</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD></TR><TR><TD ALIGN="LEFT" PORT="added_on">added_on</TD></TR></TABLE>>];
  fir_parties [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>fir_parties</B></TD></TR><TR><TD ALIGN="LEFT" PORT="party_id"><B>PK party_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="person_id">FK person_id</TD></TR><TR><TD ALIGN="LEFT" PORT="party_role">party_role</TD></TR><TR><TD ALIGN="LEFT" PORT="statement">statement</TD></TR></TABLE>>];
  fir_sections [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>fir_sections</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id"><B>PK fir_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="section_id"><B>PK section_id</B></TD></TR></TABLE>>];
  fir_status_history [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>fir_status_history</B></TD></TR><TR><TD ALIGN="LEFT" PORT="history_id"><B>PK history_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="old_status">old_status</TD></TR><TR><TD ALIGN="LEFT" PORT="new_status">new_status</TD></TR><TR><TD ALIGN="LEFT"><I>+ 2 more</I></TD></TR></TABLE>>];
  firs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>firs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id"><B>PK fir_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="station_id">FK station_id</TD></TR><TR><TD ALIGN="LEFT" PORT="complainant_person_id">FK complainant_person_id</TD></TR><TR><TD ALIGN="LEFT" PORT="complainant_officer_id">FK complainant_officer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="registered_by">FK registered_by</TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">FK category_id</TD></TR><TR><TD ALIGN="LEFT" PORT="fir_serial">fir_serial</TD></TR><TR><TD ALIGN="LEFT" PORT="reported_at">reported_at</TD></TR><TR><TD ALIGN="LEFT"><I>+ 7 more</I></TD></TR></TABLE>>];
  hearings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#d6e2f6"><B>hearings</B></TD></TR><TR><TD ALIGN="LEFT" PORT="hearing_id"><B>PK hearing_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="case_id">FK case_id</TD></TR><TR><TD ALIGN="LEFT" PORT="judge_id">FK judge_id</TD></TR><TR><TD ALIGN="LEFT" PORT="hearing_date">hearing_date</TD></TR><TR><TD ALIGN="LEFT" PORT="purpose">purpose</TD></TR><TR><TD ALIGN="LEFT"><I>+ 2 more</I></TD></TR></TABLE>>];
  investigation_assignments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#fbe7c6"><B>investigation_assignments</B></TD></TR><TR><TD ALIGN="LEFT" PORT="assignment_id"><B>PK assignment_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="fir_id">FK fir_id</TD></TR><TR><TD ALIGN="LEFT" PORT="officer_id">FK officer_id</TD></TR><TR><TD ALIGN="LEFT" PORT="assigned_on">assigned_on</TD></TR><TR><TD ALIGN="LEFT" PORT="ended_on">ended_on</TD></TR><TR><TD ALIGN="LEFT"><I>+ 2 more</I></TD></TR></TABLE>>];
  judges [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#dbeedd"><B>judges</B></TD></TR><TR><TD ALIGN="LEFT" PORT="judge_id"><B>PK judge_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="court_id">FK court_id</TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD></TR><TR><TD ALIGN="LEFT" PORT="appointed_on">appointed_on</TD></TR><TR><TD ALIGN="LEFT"><I>+ 1 more</I></TD></TR></TABLE>>];
  lab_reports [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#f6d6d6"><B>lab_reports</B></TD></TR><TR><TD ALIGN="LEFT" PORT="report_id"><B>PK report_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id">FK evidence_id</TD></TR><TR><TD ALIGN="LEFT" PORT="lab_name">lab_name</TD></TR><TR><TD ALIGN="LEFT" PORT="report_type">report_type</TD></TR><TR><TD ALIGN="LEFT"><I>+ 3 more</I></TD></TR></TABLE>>];
  legal_sections [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#e3e8ec"><B>legal_sections</B></TD></TR><TR><TD ALIGN="LEFT" PORT="section_id"><B>PK section_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">FK category_id</TD></TR><TR><TD ALIGN="LEFT" PORT="act">act</TD></TR><TR><TD ALIGN="LEFT" PORT="section_no">section_no</TD></TR><TR><TD ALIGN="LEFT"><I>+ 4 more</I></TD></TR></TABLE>>];
  officers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#dbeedd"><B>officers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="officer_id"><B>PK officer_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rank_id">FK rank_id</TD></TR><TR><TD ALIGN="LEFT" PORT="station_id">FK station_id</TD></TR><TR><TD ALIGN="LEFT" PORT="supervisor_id">FK supervisor_id</TD></TR><TR><TD ALIGN="LEFT" PORT="badge_no">badge_no</TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD></TR><TR><TD ALIGN="LEFT"><I>+ 4 more</I></TD></TR></TABLE>>];
  persons [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#dbeedd"><B>persons</B></TD></TR><TR><TD ALIGN="LEFT" PORT="person_id"><B>PK person_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="district_id">FK district_id</TD></TR><TR><TD ALIGN="LEFT" PORT="cnic">cnic</TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD></TR><TR><TD ALIGN="LEFT"><I>+ 7 more</I></TD></TR></TABLE>>];
  police_stations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#e3e8ec"><B>police_stations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="station_id"><B>PK station_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="district_id">FK district_id</TD></TR><TR><TD ALIGN="LEFT" PORT="station_code">station_code</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD></TR><TR><TD ALIGN="LEFT"><I>+ 2 more</I></TD></TR></TABLE>>];
  ranks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a99a2"><TR><TD BGCOLOR="#e3e8ec"><B>ranks</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rank_id"><B>PK rank_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD></TR><TR><TD ALIGN="LEFT" PORT="rank_level">rank_level</TD></TR><TR><TD ALIGN="LEFT"><I>+ 1 more</I></TD></TR></TABLE>>];
